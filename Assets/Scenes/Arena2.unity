  m_Script: {fileID: 11500000, guid: 1bb3d823177b5434a9b0b971294c0b15, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SimpleDialogue
  lines:
  - speaker: Light
    text: You... you actually beat the Fun Police? Nobody has ever done that.
  - speaker: You
    text: I came to bring the light back. The comic world is stuck in the dark, and Fun is lost in it.
  - speaker: Light
    text: The two worlds were never meant to be apart. Take my light. It will show you the way.
  - speaker: You
    text: Thank you. I'll take it home.
  - speaker: Light
    text: Go through the Twist and find Fun before the dark wins!
  charsPerSecond: 40
  enableWhenStarted:
  - {fileID: 1677811517}
  placeInFrontOfPlayer: 1
  enableWhenFinished:
  - {fileID: 1654693239}
